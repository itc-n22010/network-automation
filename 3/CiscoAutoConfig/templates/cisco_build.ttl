; Generated by Run-CiscoAutoConfig.ps1.
; Tera Term Language commands used here are documented commands:
; connect, logopen, logwrite, sendln, wait, pause, logclose, disconnect, end.
timeout = {{TimeoutSeconds}}
mtimeout = 0
connect '/C={{ComNumber}} /BAUD=9600'
if result=0 goto connect_error
pause 1
logopen '{{LogPath}}' 0 0 1 0 1
logwrite 'SESSION_START {{Timestamp}} COM{{ComNumber}}'#13#10
sendln
wait '#' '>'
if result=0 goto prompt_error
sendln 'enable'
wait 'Password:' '#' '>'
if result=1 sendln '{{ConsolePassword}}'
if result=1 wait '#'
if result=0 goto enable_error
sendln 'show version'
wait '#' '>'
sendln 'show inventory'
wait '#' '>'
sendln 'configure terminal'
wait '(config)#'
if result=0 goto command_error
{{ConfigCommands}}
sendln 'end'
wait '#'
sendln 'copy running-config startup-config'
wait 'Destination filename'
if result=1 sendln
wait '#'
if result=0 goto save_error
logwrite 'SESSION_SUCCESS'#13#10
goto finish
:connect_error
logwrite 'ERROR CONNECT_FAILED'#13#10
goto failed
:prompt_error
logwrite 'ERROR CISCO_PROMPT_NOT_FOUND'#13#10
goto failed
:enable_error
logwrite 'ERROR ENABLE_FAILED'#13#10
goto failed
:command_error
logwrite 'ERROR CONFIG_MODE_FAILED'#13#10
goto failed
:save_error
logwrite 'ERROR SAVE_FAILED'#13#10
goto failed
:failed
logwrite 'SESSION_FAILED'#13#10
:finish
logclose
disconnect
closett
end
